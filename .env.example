# Copy to .env and set the directory holding the CSVs
# (absolute, or relative to the repo root).
WSL_RAW_DIR=/path/to/data/raw
# DuckDB file name, created in analytics/ (dbt's catalog name is its stem)
DATABASE_NAME="warehouse.duckdb"
# Where `just publish` copies the finished marts: the app's Postgres, as the
# role that owns only its analytics schemas. Host and port default to
# localhost:5432.
PUBLISH_PG_DB=app
PUBLISH_PG_USER=pipeline_writer
PUBLISH_PG_PASSWORD=change-me
